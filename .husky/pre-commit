#!/bin/sh
. "$(dirname -- "$0")/_/husky.sh"

# AIV atomic-commit gate.
#
# Single source of truth: the entire gate decision (atomicity rules, packet and
# Layer-1 EVIDENCE recognition, change-context awareness, packet validation, and
# the safety snapshot) is delegated to the authoritative, unit-tested Python hook
# `aiv.hooks.pre_commit`. This file intentionally contains NO duplicated rule
# logic. Past drift between this bash hook and the Python hook (the bash copy did
# not recognize EVIDENCE_*.md and rejected `aiv commit` output) was exactly the
# defect class AIV exists to police (forensic finding F96 / C2). One
# implementation cannot drift from itself.
#
# Fails closed: if no Python interpreter is available, the gate blocks the commit
# rather than skipping enforcement.

if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "AIV gate: no python interpreter found; failing closed (commit blocked)." 1>&2
  echo "  Install Python and aiv-protocol (pip install -e .) and retry." 1>&2
  exit 1
fi

"$PY" -m aiv.hooks.pre_commit || exit 1

# Run lint-staged for valid commits.
if [ -f "package.json" ]; then
  if [ -f "./node_modules/lint-staged/bin/lint-staged.js" ] && command -v node >/dev/null 2>&1; then
    node ./node_modules/lint-staged/bin/lint-staged.js
  elif [ -f "./node_modules/.bin/lint-staged.cmd" ]; then
    ./node_modules/.bin/lint-staged.cmd
  elif [ -x "./node_modules/.bin/lint-staged" ]; then
    ./node_modules/.bin/lint-staged
  elif command -v npx >/dev/null 2>&1; then
    npx lint-staged
  else
    echo "ERROR: lint-staged not found. Install dependencies (e.g., npm ci) and retry." 1>&2
    exit 1
  fi
fi
